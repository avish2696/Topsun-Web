# ============================================================================
# TOPSUN E-Commerce Environment Configuration Template
# Copy this file to .env and replace placeholder values with your actual keys.
# DO NOT commit .env with real credentials to GitHub.
# ============================================================================

# ── CLIENT-SIDE CONFIGURATION (Vite exposed) ─────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

VITE_RAZORPAY_KEY_ID=rzp_live_your_key_id
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_API_BASE_URL=https://topsun.in/api
VITE_AUTH_TYPE=phone

VITE_SMTP_FROM_EMAIL=noreply@topsun.in
VITE_SMTP_FROM_NAME=TOPSUN Footwear
VITE_REPLY_TO_EMAIL=topsunshoes7@gmail.com

# ── SERVER-SIDE ONLY (Never exposed to browser bundle) ────────────────────────
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

APITXT_API_KEY=your_apitxt_sms_api_key_here

SHIPMOZO_PUBLIC_KEY=your_shipmozo_public_key_here
SHIPMOZO_PRIVATE_KEY=your_shipmozo_private_key_here

HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465
HOSTINGER_SMTP_USER=noreply@topsun.in