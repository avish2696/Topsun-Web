# ============================================================================
# TOPSUN E-Commerce Environment Configuration (Supabase Architecture)
# ============================================================================

# 1. SUPABASE CONFIGURATION
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 2. RAZORPAY PAYMENT INTEGRATION
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# 3. GOOGLE OAUTH
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# 4. AUTHENTICATION & OTP SERVICE (APITxT)
VITE_APITXT_API_KEY=your_apitxt_api_key_here
VITE_AUTH_TYPE=phone

# 5. SHIPMOZO SHIPPING INTEGRATION
VITE_SHIPMOZO_PUBLIC_KEY=your_shipmozo_public_key
VITE_SHIPMOZO_PRIVATE_KEY=your_shipmozo_private_key